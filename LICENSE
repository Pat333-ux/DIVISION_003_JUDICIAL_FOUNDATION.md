File Name: Dockerfile
Dockerfile
# ==============================================================================
# BEAST System 3.0 — Division 003 Compliance Engine Container
# ==============================================================================

FROM python:3.10-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install python requirements directly
RUN pip install --no-cache-dir jsonschema pytest

# Copy repository contents into container
COPY . /app/

# Set default execution command to run integrity verification
CMD ["python3", "scripts/verify_integrity.py"]
